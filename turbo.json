{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DIRECT_URL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "env": ["NEXT_RUNTIME", "NEXT_PHASE"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "db:generate": {
      "cache": false
    },
    "db:validate": {
      "cache": false
    }
  }
}
